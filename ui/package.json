{
  "name": "somfy-rs-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Preact web UI for somfy-rs, served from the firmware image",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src mock scripts vite.config.ts",
    "size": "bun run scripts/size.ts",
    "check": "bun run typecheck && bun run lint && bun run build && bun run size"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.3.13",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.78.0",
    "preact-render-to-string": "^6.7.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "ws": "^8.21.3"
  }
}
